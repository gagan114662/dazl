#!/usr/bin/env bash
# Gate 1 (Gagan, 2026-11-16): lint, typecheck and compile before every commit.
# Install once per clone: git config core.hooksPath .githooks   (skip in an emergency: git commit --no-verify)
set -euo pipefail
files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^web/.*\.(ts|tsx|mts|mjs|js)$' || true)
[ -z "$files" ] && exit 0
cd web
[ -d node_modules ] || { echo "pre-commit: run 'npm ci' in web/ first"; exit 1; }
echo "pre-commit: eslint on staged files"
# shellcheck disable=SC2086
npx eslint --max-warnings=0 $(echo "$files" | sed 's#^web/##')
echo "pre-commit: typecheck + compile (tsc via check:unused)"
npm run -s check:unused
