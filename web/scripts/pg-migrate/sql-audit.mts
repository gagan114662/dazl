// Postgres-readiness report (lib/db/sql-audit.ts): every SQL statement in lib/ and app/, PREPAREd on a fresh schema
// with every PG migration. Loopback / test databases only: it creates and drops one schema, nothing else.
//   DAZL_AUDIT_PG_URL=postgres://... node --experimental-strip-types scripts/pg-migrate/sql-audit.mts [--write]
// --write regenerates lib/db/pg-port-status.ts (the manifest test/pg-sql-audit.test.ts holds the code to).
import pg from 'pg'
import { randomBytes } from 'node:crypto'
import { writeFileSync } from 'node:fs'
import { join } from 'node:path'
import { sqlInventory, rawSqliteModules, pgRejects, portStatus, insertionOrderUsers } from '../../lib/db/sql-audit.ts'
import { runPgMigrations } from '../../lib/db/migrate-pg.ts'

const url = process.env.DAZL_AUDIT_PG_URL
if (!url || !/@(127\.0\.0\.1|localhost|\[::1\])[:/]/.test(url)) { console.error('set DAZL_AUDIT_PG_URL to a loopback Postgres'); process.exit(2) }
const root = join(import.meta.dirname, '..', '..')
const schema = `dazl_audit_${randomBytes(4).toString('hex')}`
const admin = new pg.Pool({ connectionString: url, max: 1 })
await admin.query(`CREATE SCHEMA ${schema}`)
const pool = new pg.Pool({ connectionString: url, max: 1, options: `-c search_path=${schema}` })
try {
  await runPgMigrations(pool)
  const sites = sqlInventory(root)
  const c = await pool.connect()
  const rejects = await pgRejects(c, sites).finally(() => c.release())
  const raw = rawSqliteModules(root)
  const status = portStatus(raw, rejects)
  for (const r of rejects) console.log(`${r.site.file}:${r.site.line}  ${r.error}\n    ${r.site.sql.replace(/\s+/g, ' ').slice(0, 160)}`)
  console.log(`\n${sites.length} statements (${sites.filter(s => s.api === 'db').length} on Db, ${sites.filter(s => s.dynamic).length} built at runtime); ${rejects.length} rejected by Postgres; ${raw.length} modules on raw SQLite`)
  if (process.argv.includes('--write')) {
    const body = Object.entries(status).map(([f, n]) => `  '${f}': ${n},`).join('\n')
    writeFileSync(join(root, 'lib/db/pg-port-status.ts'), `// Generated by scripts/pg-migrate/sql-audit.mts --write; test/pg-sql-audit.test.ts holds the code to it.
// Every module that still needs the synchronous SQLite handle, with how many of its SQL statements Postgres rejects
// today. Production can move to Postgres only when this is empty (docs/PLATFORM.md "Postgres cutover").
// Porting a module to the Db layer removes its line; a new raw-SQLite module, or a new rejected statement, fails the test.
export const RAW_SQLITE_MODULES: Record<string, number> = {
${body}
}

// Ported modules that break same-second ties with insertionOrder() (lib/db/order.ts): SQLite's rowid there, but only
// the row id on Postgres, which is not insertion order. A cutover gap until each table has an insertion-order column.
export const PG_INSERTION_ORDER_GAPS: string[] = [
${insertionOrderUsers(root).map(f => `  '${f}',`).join('\n')}
]
`)
    console.log('wrote lib/db/pg-port-status.ts')
  }
} finally { await pool.end(); await admin.query(`DROP SCHEMA ${schema} CASCADE`); await admin.end() }
