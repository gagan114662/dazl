{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:ui": "node test/ui/window-edit.ui.mjs",
    "test": "SITECRAWL_ENABLED=0 NEWS_SEARCH_ENABLED=0 node --experimental-strip-types --import ./test/helpers/net-fence.ts --test test/*.test.ts",
    "db:migrate": "node --experimental-strip-types --no-warnings scripts/db-migrate.mts",
    "prebuild": "git rev-parse HEAD > .build-commit 2>/dev/null || rm -f .build-commit",
    "test:smoke": "node test/smoke/app-pages.smoke.mjs",
    "test:smoke:chunks": "node test/smoke/chunk-recovery.smoke.mjs",
    "test:smoke:client-errors": "node test/smoke/client-errors.smoke.mjs",
    "preview:shots": "node test/smoke/preview.mjs",
    "test:smoke:auth": "node test/smoke/app-auth.smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.84",
    "@crawlee/utils": "^3.18.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/nodemailer": "^8.0.2",
    "ai": "^7.0.146",
    "better-sqlite3": "^13.0.3",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "^3.0.1",
    "tldts": "^7.4.19"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
