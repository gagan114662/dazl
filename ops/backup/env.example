# /etc/dazl-backup/env for dazl-backup.service and dazl-backup-check.service. No secrets belong here.
DB_PATH=/CHANGE-ME/production/app.db
BACKUP_DIR=/var/backups/dazl
WEB_DIR=/CHANGE-ME/release/web
# Encrypted off-host copy (optional until the owner picks a destination; docs/RECOVERY.md):
# a file of age PUBLIC keys (age1...), one per line; the private key is kept offline, never on this host
OFFHOST_AGE_RECIPIENTS=/etc/dazl-backup/recipients.txt
# a mounted directory, or rclone:REMOTE:PATH (configure the remote with `rclone config` as the app user). Both the
# copy (run-backup.sh) and the monitor (backup-check.mts) use this one setting.
OFFHOST_DEST=
# 1 once the owner has chosen a destination: then no destination, an unreadable one, or no verifiable copy alerts.
# Until then 0, and the monitor reports the off-host copy as "not configured" (local backups and the drill are checked).
OFFHOST_REQUIRED=0
# where backup-check alerts go (https)
OPS_ALERT_WEBHOOK_URL=
