# /etc/dazl-staging/env, owned by root, mode 600. deploy.sh refuses to run unless it passes its checks (deploy.sh --check-env).
# Staging only: never production's database, master key, Stripe live keys or Google credentials.
DAZL_ENV=staging
PUBLIC_BASE_URL=https://staging.dazl.ai
DB_PATH=/var/lib/dazl-staging/app.db
# a NEW key: openssl rand -base64 32 (never production's)
DAZL_MASTER_KEY=
# Stripe TEST mode (dashboard in test mode): secret key, Pro price, and the signing secret of a test-mode webhook
# endpoint for https://staging.dazl.ai/api/stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_PRICE_PRO=price_
STRIPE_WEBHOOK_SECRET=whsec_
# the demo account's password (from the PR description); the seed reads it on every deploy
STAGING_DEMO_PASSWORD=
# from Hermes; leave empty until then
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
