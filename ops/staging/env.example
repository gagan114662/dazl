# /etc/dazl-staging/env, owned by root, mode 600. deploy.sh refuses to run unless it passes its checks (deploy.sh --check-env).
# Staging only: never production's database, master key, Stripe live keys or Google credentials.
DAZL_ENV=staging
PUBLIC_BASE_URL=https://staging.dazl.ai
DB_PATH=/var/lib/dazl-staging/app.db
# a NEW key: openssl rand -base64 32 (never production's)
DAZL_MASTER_KEY=
# Stripe TEST mode (dashboard in test mode): secret key, Pro price, and the signing secret of a test-mode webhook
# endpoint for https://staging.dazl.ai/api/stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_PRICE_PRO=price_
STRIPE_WEBHOOK_SECRET=whsec_
# Sign in with Google (optional): a DEDICATED OAuth client created for staging only (consent screen scopes: openid,
# email, profile; authorized redirect URI https://staging.dazl.ai/api/auth/callback/google). Never production's client,
# and never GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET (the Gmail client): deploy.sh refuses both. Gmail stays stubbed unless the real-Gmail flag below is set.
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
# the demo account's password: generate on the host (openssl rand -base64 18), share privately; never in the repo
STAGING_DEMO_PASSWORD=
# from Hermes; leave empty until then
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
# where deploy.sh sends low-disk alerts (https; a Slack incoming webhook works); empty = journal only
OPS_ALERT_WEBHOOK_URL=

# Real staging Gmail (docs/STAGING.md, #413). Leave all four unset to keep Gmail stubbed. A staging-only Google client, never production's.
# DAZL_STAGING_REAL_GMAIL=1
# GMAIL_STAGING_CLIENT_ID=
# GMAIL_STAGING_CLIENT_SECRET=
# DAZL_STAGING_GMAIL_ALLOWLIST=owner-inbox@example.com

# Scans through the shared work queue (#836, docs/STAGING.md "Second scan worker"). With it set to exactly 1 the app and
# dazl-staging-worker.service both take scans from work_queue, each scan claimed by one of them. Unset: the app's
# in-process claimer, and the worker idles.
# DAZL_SCAN_SHARED_QUEUE=1
# TEST-ONLY (#836): hold every claimed scan this many ms (1..120000) before it runs, so a restart can be made while no
# paid request is in flight (docs/STAGING.md "Restart check"). Read only with DAZL_ENV=staging. Remove after the check.
# DAZL_STAGING_SCAN_HOLD_MS=45000
