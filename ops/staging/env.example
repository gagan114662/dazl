# /etc/dazl-staging/env, owned by root, mode 600. deploy.sh refuses to run unless it passes its checks (deploy.sh --check-env).
# Staging only: never production's database, master key, Stripe live keys or Google credentials.
DAZL_ENV=staging
PUBLIC_BASE_URL=https://staging.dazl.ai
DB_PATH=/var/lib/dazl-staging/app.db
# a NEW key: openssl rand -base64 32 (never production's)
DAZL_MASTER_KEY=
# Stripe TEST mode (dashboard in test mode): secret key, Pro price, and the signing secret of a test-mode webhook
# endpoint for https://staging.dazl.ai/api/stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_PRICE_PRO=price_
STRIPE_WEBHOOK_SECRET=whsec_
# Sign in with Google (optional): a DEDICATED OAuth client created for staging only (consent screen scopes: openid,
# email, profile; authorized redirect URI https://staging.dazl.ai/api/auth/callback/google). Never production's client,
# and never GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET (the Gmail client): deploy.sh refuses both. Gmail stays stubbed.
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
# the demo account's password: generate on the host (openssl rand -base64 18), share privately; never in the repo
STAGING_DEMO_PASSWORD=
# from Hermes; leave empty until then
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
# where deploy.sh sends low-disk and deploy-gate alerts (https; a Slack incoming webhook works); empty = journal only
OPS_ALERT_WEBHOOK_URL=
# deploy gate (ops/deploy-gate.mjs): only while the repository is private, a fine-grained read-only token for this one
# repository with Checks: read and Contents: read (free). Empty works for a public repository.
DEPLOY_GATE_GITHUB_TOKEN=
