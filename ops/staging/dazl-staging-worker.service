# staging.dazl.ai scan worker (#836, docs/STAGING.md "Second scan worker"). A second process beside the app that takes
# scans from the shared work queue: same release, same env file, same database, no port. It does nothing unless
# DAZL_SCAN_SHARED_QUEUE=1 is in the env file (it idles and says so). Not for production.
# PartOf: stopping or restarting dazl-staging.service stops this too, and restarts it when it was running. Starting the
# app does not start it: deploy.sh starts it after the app's restart, and it starts at boot when enabled.
# deploy.sh also stops it by name before a recovery point.
[Unit]
Description=dazl staging scan worker (shared work queue)
After=network.target dazl-staging.service
PartOf=dazl-staging.service

[Service]
User=dazl-staging
WorkingDirectory=/srv/dazl-staging/current/web
EnvironmentFile=/etc/dazl-staging/env
EnvironmentFile=-/var/lib/dazl-staging-deploy/release.env
Environment=NODE_ENV=production
# One scan at a time (SCAN_WORKER_CONCURRENCY, default 1). Measured 160 MB resident idle on a production-shaped
# database; its peak during a real scan is NOT measured yet (read it on the box: systemctl show -p MemoryPeak
# dazl-staging-worker). The heap cap and MemoryMax keep a runaway scan from taking the box (1.8 GB, shared with
# production); a worker killed at the cap hands nothing back, so its scan waits for the lease like any hard kill.
# Never beside a deploy that is not committed: while a recovery point is pending (a deploy between its migration and
# its commit point, or one a reboot interrupted), the database may still be rolled back, and a paid call recorded by
# the worker would be erased with it. deploy.sh starts the worker after the commit point; this keeps a boot or a hand
# start from doing it earlier. (The path is deploy.sh's STAGING_RECOVERY_ROOT default: a box that overrides that
# variable needs a drop-in with the same path here. + runs the check as root.)
ExecCondition=+/usr/bin/test ! -e /var/lib/dazl-staging-recovery/pending
ExecStart=/usr/bin/node --experimental-strip-types --no-warnings --max-old-space-size=448 scripts/scan-worker.mts
Restart=on-failure
RestartSec=5
MemoryHigh=560M
MemoryMax=640M
# SIGTERM: the worker hands its running scan back to the queue and exits (143 is its normal stop)
SuccessExitStatus=143
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
