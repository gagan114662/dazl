worker/node_modules/
worker/.dev.vars
.DS_Store
*.xcuserstate
build/
releases/
# Claude Code: local state stays ignored; the shared skills and reviewer agents are committed (.claude/skills/README.md)
.claude/*
!.claude/skills/
!.claude/agents/
coding-plans/

# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml

# Claude Code configuration (managed by swamp)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
# END swamp managed section


# Scoreboard results hold lead and contact data: never commit them
scoreboard/results/
quality-report.json

# Stray JSON log lines saved as files at the repo root (a staging_deploy alert body was committed once). Such names
# contain characters invalid on Windows and break checkout there.
/{"level"*

# Python bytecode caches (ops/ helpers and tests): build output, never committed.
__pycache__/
