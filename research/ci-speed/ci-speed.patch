From 163f3654dbd332dd7928db9a8621270e2b76417c Mon Sep 17 00:00:00 2001
From: gagan114662 <gagan@getfoolish.com>
Date: Fri, 20 Nov 2026 18:27:55 +0000
Subject: [PATCH] CI: shard web-ci 4 ways, cache Playwright browsers and Next
 build cache (refs #1434-independent CI speed)

---
 .github/scripts/full-suite-ci.test.mjs  | 17 +++++--
 .github/scripts/never-again.test.mjs    |  6 ++-
 .github/workflows/release-gate.yml      | 29 +++++++++++
 .github/workflows/release-preflight.yml |  5 ++
 .github/workflows/web-ci.yml            | 64 ++++++++++++++++++++-----
 .github/workflows/web-preview.yml       | 11 +++++
 6 files changed, 116 insertions(+), 16 deletions(-)

diff --git a/.github/scripts/full-suite-ci.test.mjs b/.github/scripts/full-suite-ci.test.mjs
index 9c03923..0b31b2c 100644
--- a/.github/scripts/full-suite-ci.test.mjs
+++ b/.github/scripts/full-suite-ci.test.mjs
@@ -22,7 +22,7 @@ const SELECT = 'if [ "$FULL_SUITE" = true ]; then sel=ALL; else sel=$(node .gith
 const timeoutFor = (event, labels) => (event === 'pull_request' && !labels.includes('full-suite-ci') ? 5 : 45)
 
 test('label on/off: both PR test jobs use the 45-min ceiling only with full-suite-ci', () => {
-  for (const name of ['test-sqlite', 'test-postgres']) {
+  for (const name of ['sqlite-shard', 'postgres-shard']) {
     const lines = job(name).split('\n').map(l => l.trim())
     assert.ok(lines.includes(TIMEOUT), `${name}: timeout must honour the full-suite-ci label`)
   }
@@ -33,12 +33,14 @@ test('label on/off: both PR test jobs use the 45-min ceiling only with full-suit
 })
 
 test('full-suite selection: the label forces ALL, otherwise affected-tests decides', () => {
-  for (const name of ['test-sqlite', 'test-postgres']) {
+  for (const name of ['sqlite-shard', 'postgres-shard']) {
     const j = job(name)
     const lines = j.split('\n').map(l => l.trim())
     assert.ok(lines.includes(FULL_ENV), `${name}: selection step reads the label`)
     assert.ok(j.includes(SELECT), `${name}: label => sel=ALL`)
-    assert.match(j, /\[ "\$SEL" = ALL \]; then npm test/, `${name}: ALL still runs the whole npm test suite`)
+    assert.match(j, /\[ "\$SEL" = ALL \]; then all=\$\(ls test\/\*\.test\.ts test\/crm-webhook-unknown-ui\.test\.mjs\)/, `${name}: ALL still runs the whole npm test list`)
+    assert.match(j, /shard: \[1, 2, 3, 4\]/, `${name}: 4 shards`)
+    assert.match(j, /'NF && \(NR-1\)%n==i-1'/, `${name}: each file lands in exactly one shard`)
   }
 })
 
@@ -47,12 +49,19 @@ test('adding or removing the label re-runs CI', () => {
 })
 
 test('nothing else is loosened: migrations, pr-budget cancel detection, no manual success status on PRs', () => {
-  const pg = job('test-postgres')
+  const pg = job('postgres-shard')
   assert.match(pg, /npm run db:migrate \| grep -q 'applied \\\[\\\]'/, 'migrate-twice check kept')
   assert.match(pg, /test\/leads-read-pg-live\.test\.ts/, 'live leads-read contract kept')
   const b = job('pr-budget')
   assert.match(b, /if \[ "\$R1" = cancelled \] \|\| \[ "\$R2" = cancelled \]; then/)
   assert.match(b, /exit 1/)
+  for (const [req, shard] of [['test-sqlite', 'sqlite-shard'], ['test-postgres', 'postgres-shard']]) {
+    const j = job(req)
+    assert.match(j, new RegExp(`needs: ${shard}`), `${req} waits for every shard`)
+    assert.ok(j.includes(`[ "\${{ needs.${shard}.result }}" = success ] || {`), `${req} fails unless every shard passed`)
+    assert.match(j, /if: always\(\)/, `${req} reports even when a shard fails`)
+  }
+  assert.match(job('main-green'), /needs: \[test-sqlite, test-postgres\]/)
   assert.match(job('main-green'), /if: github\.event_name == 'push' && github\.ref == 'refs\/heads\/main'/)
   assert.equal((wf.match(/state=success/g) || []).length, 1, 'only main-green sets a success status')
 })
diff --git a/.github/scripts/never-again.test.mjs b/.github/scripts/never-again.test.mjs
index c645924..1a9ede7 100644
--- a/.github/scripts/never-again.test.mjs
+++ b/.github/scripts/never-again.test.mjs
@@ -36,7 +36,11 @@ test('the gates NEVER-AGAIN.md names are still wired', () => {
   assert.match(read('web/test/request-log.test.ts'), /test\('the route list matches the route files under app\//, '#7')
   assert.match(JSON.parse(read('web/package.json')).scripts.test, /test\/\*\.test\.ts/, '#7: npm test runs test/*.test.ts')
   // CI gates (2026-11-16): web-ci runs the full `npm test` post-merge on main (and on PRs that touch shared plumbing)
-  assert.match(read('.github/workflows/web-ci.yml'), /then npm test\b|run: npm test/, '#7: web-ci runs npm test')
+  // web-ci shards the exact `npm test` file list 4 ways; a guard fails the run if package.json's test script drifts from it
+  const webci = read('.github/workflows/web-ci.yml')
+  assert.ok(webci.includes(`[ "$(node -p 'require("./package.json").scripts.test')" = "$want" ]`), '#7: web-ci guards the npm test script')
+  assert.ok(webci.includes("want='" + JSON.parse(read('web/package.json')).scripts.test + "'"), '#7: web-ci shard list is exactly npm test')
+  assert.match(webci, /then all=\$\(ls test\/\*\.test\.ts test\/crm-webhook-unknown-ui\.test\.mjs\)/, '#7: web-ci runs the full npm test list on main')
   assert.match(read('ops/prod/test_prod_prebuilt.py'), /def test_the_deploy_script_contains_no_build_step/, '#1 prod')
   assert.match(read('ops/staging/deploy.sh'), /REFUSED: no on-box build/, '#1 staging')
   assert.match(read('.github/workflows/release-preflight.yml'), /unittest discover -s ops -p 'test_\*\.py'/, '#1: ops/test_never_again.py runs')
diff --git a/.github/workflows/release-gate.yml b/.github/workflows/release-gate.yml
index c8bd276..e4e1557 100644
--- a/.github/workflows/release-gate.yml
+++ b/.github/workflows/release-gate.yml
@@ -46,11 +46,22 @@ jobs:
           node-version: 22
           cache: npm
           cache-dependency-path: web/package-lock.json
+      # Next.js incremental build cache: speeds up `next build`, never changes what is built or tested
+      - uses: actions/cache@v4
+        with:
+          path: web/.next/cache
+          key: next-${{ runner.os }}-${{ hashFiles('web/package-lock.json') }}-${{ github.sha }}
+          restore-keys: next-${{ runner.os }}-${{ hashFiles('web/package-lock.json') }}-
       - run: npm ci
       - run: npm run build
       - name: Release manifest
         run: node ../ops/release-manifest.mjs write . release.json && cat release.json
       # Playwright is not an app dependency: installed for this job only, the lockfile untouched
+      # Playwright's Chromium download is cached per version (it took up to 7.5 min uncached); --with-deps still installs the OS libraries every run
+      - uses: actions/cache@v4
+        with:
+          path: ~/.cache/ms-playwright
+          key: playwright-1.63.0-${{ runner.os }}-${{ runner.arch }}
       - run: npm install --no-save playwright@1.63.0 && npx playwright install --with-deps chromium
       - name: Every /app page loads (no page/console error, no missing asset)
         run: npm run test:smoke
@@ -184,6 +195,12 @@ jobs:
           node-version: 22.23.3
           cache: npm
           cache-dependency-path: web/package-lock.json
+      # Next.js incremental build cache: speeds up `next build`, never changes what is built or tested
+      - uses: actions/cache@v4
+        with:
+          path: web/.next/cache
+          key: next-${{ runner.os }}-${{ hashFiles('web/package-lock.json') }}-${{ github.sha }}
+          restore-keys: next-${{ runner.os }}-${{ hashFiles('web/package-lock.json') }}-
       - run: npm ci
       - run: npm run build
       - run: node scripts/check-fixture-route-artifact.mjs production
@@ -295,6 +312,12 @@ jobs:
           node-version: 22.23.3
           cache: npm
           cache-dependency-path: web/package-lock.json
+      # Next.js incremental build cache: speeds up `next build`, never changes what is built or tested
+      - uses: actions/cache@v4
+        with:
+          path: web/.next/cache
+          key: next-${{ runner.os }}-${{ hashFiles('web/package-lock.json') }}-${{ github.sha }}
+          restore-keys: next-${{ runner.os }}-${{ hashFiles('web/package-lock.json') }}-
       - run: npm ci
       - name: Checker self-test (production-shaped responses must fail every marker)
         working-directory: .
@@ -388,6 +411,12 @@ jobs:
           node-version: 22
           cache: npm
           cache-dependency-path: web/package-lock.json
+      # Next.js incremental build cache: speeds up `next build`, never changes what is built or tested
+      - uses: actions/cache@v4
+        with:
+          path: web/.next/cache
+          key: next-${{ runner.os }}-${{ hashFiles('web/package-lock.json') }}-${{ github.sha }}
+          restore-keys: next-${{ runner.os }}-${{ hashFiles('web/package-lock.json') }}-
       - run: npm ci
         working-directory: web
       - name: Previous release checkout and production build
diff --git a/.github/workflows/release-preflight.yml b/.github/workflows/release-preflight.yml
index d7b2a28..9340fbf 100644
--- a/.github/workflows/release-preflight.yml
+++ b/.github/workflows/release-preflight.yml
@@ -31,6 +31,11 @@ jobs:
         with:
           node-version: 22
       # ops/prod (the production deploy from a prebuilt build, #907) has no __init__.py either: its own step.
+      # Playwright's Chromium download is cached per version (it took up to 7.5 min uncached); --with-deps still installs the OS libraries every run
+      - uses: actions/cache@v4
+        with:
+          path: ~/.cache/ms-playwright
+          key: playwright-1.63.0-${{ runner.os }}-${{ runner.arch }}
       - name: Ops prod tests (ops/prod/test_*.py)
         env:
           PLAYWRIGHT_BROWSERS_PATH: ${{ runner.temp }}/dazl-preflight-browser
diff --git a/.github/workflows/web-ci.yml b/.github/workflows/web-ci.yml
index c884e79..08a6bb7 100644
--- a/.github/workflows/web-ci.yml
+++ b/.github/workflows/web-ci.yml
@@ -14,7 +14,14 @@ concurrency:
   cancel-in-progress: ${{ github.event_name == 'pull_request' }}
 jobs:
   # Full suite on SQLite, today's runtime store. PG-only tests skip here.
-  test-sqlite:
+  # Sharded 4 ways (round-robin over the exact `npm test` file list, or over the PR's affected list) so the full suite on
+  # main finishes in ~1/4 of the old 25 min. Every file still runs in exactly one shard; the test-sqlite and
+  # test-postgres jobs below keep the required check names and fail unless every shard passed.
+  sqlite-shard:
+    strategy:
+      fail-fast: false
+      matrix:
+        shard: [1, 2, 3, 4]
     runs-on: ubuntu-latest
     # Gate 2: PRs get a hard 5-minute budget (affected tests only); main runs the full suite (gate 3).
     # A reviewer-applied `full-suite-ci` label gives a PR the 45-minute ceiling AND forces ALL (#1099/#1273, Hermes F1).
@@ -45,6 +52,7 @@ jobs:
       # one tsc pass: ordinary type errors AND unused locals/imports/parameters (narrow documented exemptions, #898).
       # check-unused fails on any non-unused TS error too, so a separate `tsc --noEmit` step would only compile twice.
       - name: Lint changed files (PR) / typecheck (main)
+        if: matrix.shard == 1
         env:
           PR_BASE_SHA: ${{ steps.pr_base.outputs.sha }}
         run: |
@@ -72,15 +80,25 @@ jobs:
           DAZL_REQUIRE_AGE: "1"
           SEL: ${{ steps.sel.outputs.tests }}
         run: |
-          if [ "${{ github.event_name }}" != pull_request ] || [ "$SEL" = ALL ]; then npm test
-          elif [ "$SEL" = NONE ]; then echo "no affected tests"
-          else SITECRAWL_ENABLED=0 NEWS_SEARCH_ENABLED=0 node --experimental-strip-types --import ./test/helpers/net-fence.ts --test $SEL
+          # the full list is exactly what `npm test` runs; the guard fails loudly if package.json's test script changes
+          want='SITECRAWL_ENABLED=0 NEWS_SEARCH_ENABLED=0 node --experimental-strip-types --import ./test/helpers/net-fence.ts --test test/*.test.ts test/crm-webhook-unknown-ui.test.mjs'
+          [ "$(node -p 'require("./package.json").scripts.test')" = "$want" ] || { echo "::error::web/package.json test script changed: update the shard list in web-ci.yml"; exit 1; }
+          if [ "${{ github.event_name }}" != pull_request ] || [ "$SEL" = ALL ]; then all=$(ls test/*.test.ts test/crm-webhook-unknown-ui.test.mjs)
+          elif [ "$SEL" = NONE ]; then echo "no affected tests"; exit 0
+          else all=$SEL
           fi
+          mine=$(printf '%s\n' $all | sort | awk -v n=4 -v i=${{ matrix.shard }} 'NF && (NR-1)%n==i-1')
+          echo "shard ${{ matrix.shard }}/4: $(printf '%s\n' $mine | grep -c .) of $(printf '%s\n' $all | grep -c .) files"
+          [ -z "$mine" ] || SITECRAWL_ENABLED=0 NEWS_SEARCH_ENABLED=0 node --experimental-strip-types --import ./test/helpers/net-fence.ts --test $mine
 
   # Full suite again with a Postgres 16 service container. Tests that take DAZL_TEST_PG_URL run against it (data layer
   # contract, migrations, schema drift) and DAZL_REQUIRE_PG=1 makes them fail instead of skipping if it is missing.
   # Modules not yet moved to lib/db/client.ts still run on SQLite in this job (docs/PLATFORM.md step 2).
-  test-postgres:
+  postgres-shard:
+    strategy:
+      fail-fast: false
+      matrix:
+        shard: [1, 2, 3, 4]
     runs-on: ubuntu-latest
     timeout-minutes: ${{ github.event_name == 'pull_request' && !contains(github.event.pull_request.labels.*.name, 'full-suite-ci') && 5 || 45 }}
     services:
@@ -133,17 +151,41 @@ jobs:
         env:
           SEL: ${{ steps.sel.outputs.tests }}
         run: |
-          if [ "${{ github.event_name }}" != pull_request ] || [ "$SEL" = ALL ]; then npm test
-          elif [ "$SEL" = NONE ]; then echo "no affected tests"
-          else SITECRAWL_ENABLED=0 NEWS_SEARCH_ENABLED=0 node --experimental-strip-types --import ./test/helpers/net-fence.ts --test $SEL
+          # the full list is exactly what `npm test` runs; the guard fails loudly if package.json's test script changes
+          want='SITECRAWL_ENABLED=0 NEWS_SEARCH_ENABLED=0 node --experimental-strip-types --import ./test/helpers/net-fence.ts --test test/*.test.ts test/crm-webhook-unknown-ui.test.mjs'
+          [ "$(node -p 'require("./package.json").scripts.test')" = "$want" ] || { echo "::error::web/package.json test script changed: update the shard list in web-ci.yml"; exit 1; }
+          if [ "${{ github.event_name }}" != pull_request ] || [ "$SEL" = ALL ]; then all=$(ls test/*.test.ts test/crm-webhook-unknown-ui.test.mjs)
+          elif [ "$SEL" = NONE ]; then echo "no affected tests"; exit 0
+          else all=$SEL
           fi
+          mine=$(printf '%s\n' $all | sort | awk -v n=4 -v i=${{ matrix.shard }} 'NF && (NR-1)%n==i-1')
+          echo "shard ${{ matrix.shard }}/4: $(printf '%s\n' $mine | grep -c .) of $(printf '%s\n' $all | grep -c .) files"
+          [ -z "$mine" ] || SITECRAWL_ENABLED=0 NEWS_SEARCH_ENABLED=0 node --experimental-strip-types --import ./test/helpers/net-fence.ts --test $mine
       - name: db:migrate against the service container, twice (second run must apply nothing)
+        if: matrix.shard == 1
         run: |
           DATABASE_URL=$DAZL_TEST_PG_URL npm run db:migrate
           DATABASE_URL=$DAZL_TEST_PG_URL npm run db:migrate | grep -q 'applied \[\]'
       - name: live leads-read contract on the regenerated schema
+        if: matrix.shard == 1
         run: DAZL_PG_ADMIN=$DAZL_TEST_PG_URL node --experimental-strip-types --test test/leads-read-pg-live.test.ts
 
+  # Required checks: these names are what branch protection requires. Each passes only if every shard passed.
+  test-sqlite:
+    if: always()
+    needs: sqlite-shard
+    runs-on: ubuntu-latest
+    timeout-minutes: 2
+    steps:
+      - run: '[ "${{ needs.sqlite-shard.result }}" = success ] || { echo "::error::sqlite shards: ${{ needs.sqlite-shard.result }}"; exit 1; }'
+  test-postgres:
+    if: always()
+    needs: postgres-shard
+    runs-on: ubuntu-latest
+    timeout-minutes: 2
+    steps:
+      - run: '[ "${{ needs.postgres-shard.result }}" = success ] || { echo "::error::postgres shards: ${{ needs.postgres-shard.result }}"; exit 1; }'
+
   # Gate 3: after the full suite passes on main, mark the commit green. Only main-green commits may deploy (prod-deploy.yml).
   main-green:
     if: github.event_name == 'push' && github.ref == 'refs/heads/main'
@@ -167,14 +209,14 @@ jobs:
   # Gate 2: say clearly when a PR job hit the 5-minute budget, so an optimization lane gets opened.
   pr-budget:
     if: always() && github.event_name == 'pull_request'
-    needs: [test-sqlite, test-postgres]
+    needs: [sqlite-shard, postgres-shard]
     runs-on: ubuntu-latest
     timeout-minutes: 2
     steps:
       - name: Budget report
         env:
-          R1: ${{ needs.test-sqlite.result }}
-          R2: ${{ needs.test-postgres.result }}
+          R1: ${{ needs.sqlite-shard.result }}
+          R2: ${{ needs.postgres-shard.result }}
         run: |
           echo "test-sqlite=$R1 test-postgres=$R2"
           if [ "$R1" = cancelled ] || [ "$R2" = cancelled ]; then
diff --git a/.github/workflows/web-preview.yml b/.github/workflows/web-preview.yml
index f138fca..e569c07 100644
--- a/.github/workflows/web-preview.yml
+++ b/.github/workflows/web-preview.yml
@@ -29,9 +29,20 @@ jobs:
           node-version: 22
           cache: npm
           cache-dependency-path: web/package-lock.json
+      # Next.js incremental build cache: speeds up `next build`, never changes what is built or tested
+      - uses: actions/cache@v4
+        with:
+          path: web/.next/cache
+          key: next-${{ runner.os }}-${{ hashFiles('web/package-lock.json') }}-${{ github.sha }}
+          restore-keys: next-${{ runner.os }}-${{ hashFiles('web/package-lock.json') }}-
       - run: npm ci
       - run: npm run build
       # Playwright (and esbuild, for the rendered check) are not app dependencies: installed for this job only, the lockfile untouched
+      # Playwright's Chromium download is cached per version (it took up to 7.5 min uncached); --with-deps still installs the OS libraries every run
+      - uses: actions/cache@v4
+        with:
+          path: ~/.cache/ms-playwright
+          key: playwright-1.63.0-${{ runner.os }}-${{ runner.arch }}
       - run: npm install --no-save playwright@1.63.0 esbuild@0.25.0 && npx playwright install --with-deps chromium
       # The rendered price-estimate check (stubbed: no server, db, network or key). esbuild bundles the page; installed with playwright for this job only, the lockfile untouched. It must run, not skip.
       - name: Rendered price-estimate and budget check
-- 
